//@version=6
indicator("Volume Flow Bubbles [LTF]", overlay = true, max_labels_count = 500)

// ════════════════════════════════════════════════════════════════════
//  ROOT CAUSE FIX (phát hiện bởi swarm agents):
//
//  BUG CŨ: if bar_index >= last_bar_index - N → chạy trên NHIỀU bars
//    → mỗi lần chạy tạo labels MỚI với ltf data của bar HIỆN TẠI
//    → labels từ bar cũ bị xóa do max_labels_count = 500
//    → kết quả: tất cả bubbles dùng ltf prices của bar cuối cùng
//    → bubbles hiện đúng 1 nến cuối, sai giá cho tất cả nến trước
//
//  FIX: Chạy TOÀN BỘ vòng lặp chỉ 1 LẦN trên barstate.islast
//    + Dùng ltf_high[offset] để lấy historical LTF array đúng bar
//    + Dùng xloc.bar_time để đặt x-position đúng trong từng nến
// ════════════════════════════════════════════════════════════════════

// ─── INPUTS ──────────────────────────────────────────────────────────────────
var string G1 = "⚙️ Lower Timeframe"
i_auto_ltf = input.bool(true, "Auto-detect LTF", group = G1)
i_ltf      = input.timeframe("1", "Manual LTF", group = G1)

var string G2 = "🎯 Filter"
i_top_pct = input.float(25.0, "Show top % LTF bars", group = G2,
  minval = 5.0, maxval = 100.0)
i_min_dom = input.float(55.0, "Min Buy/Sell Dominance %", group = G2,
  minval = 50.0, maxval = 95.0)
i_bars    = input.int(12, "Số main candles hiển thị", group = G2,
  minval = 1, maxval = 30,
  tooltip = "12 bars × ~10 LTF ≈ 120 labels. Giữ ≤ 20 để không vượt 500.")

var string G3 = "🎨 Display"
buyColor  = input.color(color.new(#00ffaa, 10), "Buy Color",  group = G3)
sellColor = input.color(color.new(#ff2222,  5), "Sell Color", group = G3)
showText  = input.bool(false, "Show volume text", group = G3)

// ─── AUTO LTF ────────────────────────────────────────────────────────────────
string auto_ltf = "1"
if timeframe.isseconds
    auto_ltf := "1S"
else if timeframe.multiplier <= 3
    auto_ltf := "1"
else if timeframe.multiplier <= 15
    auto_ltf := "3"
else if timeframe.multiplier <= 60
    auto_ltf := "15"
else if timeframe.multiplier <= 240
    auto_ltf := "30"
else if timeframe.isdaily
    auto_ltf := "60"
else
    auto_ltf := "D"

string ltf = i_auto_ltf ? auto_ltf : i_ltf

// ─── LTF REQUEST (PHẢI Ở GLOBAL SCOPE) ───────────────────────────────────────
// Gọi ở đây để Pine pre-fetch data cho TẤT CẢ historical bars
// KHÔNG gọi trong if/for block → sẽ mất data historical
float[] ltf_h = request.security_lower_tf(syminfo.tickerid, ltf, high)
float[] ltf_l = request.security_lower_tf(syminfo.tickerid, ltf, low)
float[] ltf_c = request.security_lower_tf(syminfo.tickerid, ltf, close)
float[] ltf_v = request.security_lower_tf(syminfo.tickerid, ltf, volume)

// ─── HELPERS ─────────────────────────────────────────────────────────────────
f_sz(float ratio) =>
    string s = size.tiny
    if ratio >= 0.75
        s := size.large
    else if ratio >= 0.45
        s := size.normal
    else if ratio >= 0.15
        s := size.small
    s

f_fmt(float v) =>
    string r = str.tostring(v, "#")
    if v >= 1e9
        r := str.tostring(v / 1e9, "#.#") + "B"
    else if v >= 1e6
        r := str.tostring(v / 1e6, "#.#") + "M"
    else if v >= 1e3
        r := str.tostring(v / 1e3, "#.#") + "K"
    r

// ─── DRAW: CHỈ CHẠY 1 LẦN TRÊN BARSTATE.ISLAST ───────────────────────────────
// KEY: dùng ltf_h[offset] → lấy đúng historical LTF array của từng bar
if barstate.islast
    for offset = 0 to i_bars - 1

        // LTF arrays của bar cách đây `offset` bars
        float[] h_arr = ltf_h[offset]
        float[] l_arr = ltf_l[offset]
        float[] c_arr = ltf_c[offset]
        float[] v_arr = ltf_v[offset]

        int n = array.size(v_arr)
        if n == 0
            continue

        // HTF bar's range để clamp y-position
        float htf_h = high[offset]
        float htf_l = low[offset]

        // Timestamps để trải bubbles đều trong bar (xloc.bar_time)
        int bar_t  = int(time[offset])
        int tf_ms  = int(timeframe.in_seconds() * 1000)

        // Max volume trong bar này để normalize size
        float max_v = array.max(v_arr)
        if max_v <= 0
            continue

        float thresh = max_v * (1.0 - i_top_pct / 100.0)

        for i = 0 to n - 1
            float h   = nz(array.get(h_arr, i))
            float l   = nz(array.get(l_arr, i))
            float c   = nz(array.get(c_arr, i))
            float v   = nz(array.get(v_arr, i))
            float rng = h - l

            if v < thresh or rng <= 0
                continue

            float buy_v  = v * (c - l) / rng
            float sell_v = v * (h - c) / rng
            float tv     = buy_v + sell_v
            if tv <= 0
                continue

            float buy_dom  = buy_v  / tv * 100.0
            float sell_dom = sell_v / tv * 100.0
            bool  is_buy   = buy_dom  >= i_min_dom
            bool  is_sell  = sell_dom >= i_min_dom

            if not is_buy and not is_sell
                continue

            float ratio = v / max_v

            // Y: giá thực của LTF bar, clamp vào range HTF bar
            float y_pos = math.max(htf_l, math.min(htf_h, (h + l) / 2.0))

            // X: trải đều theo thời gian trong HTF bar
            int x_time = bar_t + int(tf_ms * i / math.max(n, 1))

            color col = is_buy
              ? color.new(buyColor,  int(85 - ratio * 70))
              : color.new(sellColor, int(80 - ratio * 70))

            label.new(
              x         = x_time,
              xloc      = xloc.bar_time,
              y         = y_pos,
              text      = showText ? f_fmt(v) : "",
              style     = label.style_circle,
              color     = col,
              textcolor = chart.fg_color,
              size      = f_sz(ratio))
