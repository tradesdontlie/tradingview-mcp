// Telegram bot — STUB (all features removed 2026-06-08)
// Dùng Claude Code skills thay thế: /scan, /check, /ta, /brief, /monitor

import https from 'https';

const TOKEN   = process.env.TELEGRAM_BOT_TOKEN || '';
const CHAT_ID = process.env.TELEGRAM_CHAT_ID || '';
const API     = `https://api.telegram.org/bot${TOKEN}`;

function tgRequest(method, params) {
    return new Promise((resolve, reject) => {
        const body = JSON.stringify(params);
        const req  = https.request(`${API}/${method}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body) }
        }, res => {
            let data = '';
            res.on('data', c => data += c);
            res.on('end', () => {
                try { resolve(JSON.parse(data)); } catch { resolve({}); }
            });
        });
        req.on('error', reject);
        req.write(body);
        req.end();
    });
}

function sendMsg(chatId, text) {
    return tgRequest('sendMessage', { chat_id: chatId, text, parse_mode: 'HTML' });
}

async function getUpdates(offset, timeout = 25) {
    const r = await tgRequest('getUpdates', { offset, timeout, allowed_updates: ['message'] });
    return (r && r.result) ? r.result : [];
}

let offset_id = 0;

async function poll() {
    try {
        const updates = await getUpdates(offset_id);
        for (const upd of updates) {
            offset_id = upd.update_id + 1;
            if (upd.message && String(upd.message.chat.id) === String(CHAT_ID)) {
                await sendMsg(CHAT_ID,
                    '⏸ <b>Bot đã ngừng hoạt động.</b>\n' +
                    'Dùng Claude Code skills thay thế:\n' +
                    '<code>/scan /check /ta /brief /monitor</code>'
                );
            }
        }
    } catch (e) {
        console.error('Poll error:', e.message);
        await new Promise(r => setTimeout(r, 5000));
    }
    setImmediate(poll);
}

console.log('=== Telegram Bot (stub — all features disabled) ===');

sendMsg(CHAT_ID,
    '⏸ <b>Bot đã tắt tất cả tính năng.</b>\n' +
    'Dùng Claude Code skills thay thế: /scan, /check, /ta, /brief'
).catch(() => {});

poll();
