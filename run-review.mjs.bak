const line = 'â”€'.repeat(54);
console.log(`\n${line}`);
console.log(`ðŸ“Š  REVIEW CUá»I PHIÃŠN â€” Thá»© TÆ° 21/05/2026`);
console.log(line);
console.log(`VNINDEX  ${fmtPrice(vnq?.close)}  ${vnChg >= 0 ? '+' : ''}${vnChg}%  ${vnDir}`);
console.log(`Breadth  â–²${breadthUp} mÃ£  â”€${breadthFlat} mÃ£  â–¼${breadthDown} mÃ£`);
if (topSectors) console.log(`Dáº«n dáº¯t  ${topSectors}`);
console.log(`Signal   ðŸŸ¢ BUY ${buyList.length}  Â·  ðŸ”¶ WATCH ${watchList.length}  Â·  âš ï¸  DIV ${divList.length}`);

