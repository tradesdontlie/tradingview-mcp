+// Decision co hoc tu scenarios (engine da gate: scenarios rong = khong co keo long kha thi
+// vi dir SHORT/NEUTRAL chan het scenario builder). READY = gia dang trong entry zone;
+// WATCH = co setup nhung cho trigger; AVOID = khong co setup. KHONG tu phat BUY (do LLM/nguoi quyet).
+export function computeDecision(scenarios, price) {
+  if (!scenarios || scenarios.length === 0) {
+    return { state: 'AVOID', reason: 'khong co kich ban long kha thi', setup: null };
+  }
+  const inZone = scenarios.find(s =>
+    price >= Math.min(s.entry_low, s.entry_high) && price <= Math.max(s.entry_low, s.entry_high));
+  if (inZone) {
+    return { state: 'READY', reason: `gia trong entry zone (${inZone.label})`, setup: inZone.label };
+  }
+  return { state: 'WATCH', reason: `co setup ${scenarios[0].label}, cho trigger`, setup: scenarios[0].label };
+}
